{
  "schema_version": "1.0",
  "case_id": "lid_driven_cavity_re100_transient",
  "description": "Transient 64x64 Re=100 cavity with a linearly accelerating top plate.",
  "units": "SI",
  "physics": {
    "model": "incompressible_laminar",
    "transient": true
  },
  "domain": {
    "type": "rectangle",
    "width_m": 1.0,
    "height_m": 1.0
  },
  "mesh": {
    "type": "uniform_cartesian",
    "nx": 16,
    "ny": 16
  },
  "material": {
    "type": "newtonian_fluid",
    "density_kg_m3": 1.0,
    "dynamic_viscosity_pa_s": 0.01
  },
  "initial_conditions": {
    "u_m_s": 0.0,
    "v_m_s": 0.0,
    "pressure_pa": 0.0
  },
  "boundary_conditions": {
    "west": {"type": "no_slip_wall"},
    "east": {"type": "no_slip_wall"},
    "south": {"type": "no_slip_wall"},
    "north": {
      "type": "moving_wall",
      "velocity_profile": [
        {"time_s": 0.0, "velocity_m_s": [0.0, 0.0]},
        {"time_s": 1.0, "velocity_m_s": [1.0, 0.0]},
        {"time_s": 2.0, "velocity_m_s": [2.0, 0.0]},
        {"time_s": 3.0, "velocity_m_s": [3.0, 0.0]},
        {"time_s": 4.0, "velocity_m_s": [4.0, 0.0]},
        {"time_s": 5.0, "velocity_m_s": [4.0, 0.0]},
        {"time_s": 6.0, "velocity_m_s": [4.0, 0.0]}
      ]
    },
    "pressure_correction": "homogeneous_neumann"
  },
  "solver": {
    "max_time_step_s": 0.01,
    "minimum_time_step_s": 1e-12,
    "max_steps": 10000,
    "cfl_limit": 0.5,
    "velocity_tolerance_m_s": 1e-6,
    "continuity_tolerance_s_inv": 1e-8,
    "mass_tolerance_m2_s": 1e-10,
    "momentum_residual_tolerance": 1e-10,
    "pressure_residual_tolerance": 1e-10,
    "end_time_s": 6.0,
    "max_inner_iterations_per_time_step": 1000
  }
}